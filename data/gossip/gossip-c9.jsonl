{"id": "c903f8b7aa153bd7", "field": "text", "it": "Cerca di mantenere l'equilibrio in ogni cosa, {class}. È lì che si trova la vera armonia.", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g04-sg2@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "c903f8b7aa153bd7", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
