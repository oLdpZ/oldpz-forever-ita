{"id": "182990b13702825b", "field": "text", "it": "Ora mettiamo alla prova il mio progetto!", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g15-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "182990b13702825b", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
