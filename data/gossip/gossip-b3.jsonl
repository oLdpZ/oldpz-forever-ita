{"id": "b3433dc4e1f8ce59", "field": "text", "it": "Qui! Dentro la stanza. Hai trovato la chiave delle mie catene? Ce l'ha l'umano Borhuin.", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g32-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "b3433dc4e1f8ce59", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
