{"id": "58e5d795eafd567b", "field": "text", "it": "Faccio parte dei Sette, ed è nostro destino montare la guardia. Per sempre.", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g22-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "58e5d795eafd567b", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
