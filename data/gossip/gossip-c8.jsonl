{"id": "c8620fb75095e29b", "field": "text", "it": "Guarda, là! Vicino all'⟦Hive'Regal=Alveare Regal⟧! Quello è... un verme delle sabbie?!", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g34-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "c8620fb75095e29b", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
