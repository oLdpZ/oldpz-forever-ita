{"id": "fc3a602c449b2f49", "field": "text", "it": "Ho sentito che i troll del ⟦Sen'jin Village=Villaggio di Sen'jin⟧ hanno un preparatore di pozioni di nome Miao'zan. Cerca lì.", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g40-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "fc3a602c449b2f49", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
