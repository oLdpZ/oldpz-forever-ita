{"id": "f7693d23090c8d26", "field": "text", "it": "Credo che avrai più fortuna a cercare a ⟦Stormwind=Roccavento⟧. Chiedi a una guardia lassù e ti indicherà la strada giusta.", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g39-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "f7693d23090c8d26", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
