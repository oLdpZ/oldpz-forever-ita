{"id": "373c11fe7bd9a723", "field": "text", "it": "Scendi subito da lì! Non voglio che ti arrampichi su quel coso. Non è sicuro.", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g19-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "373c11fe7bd9a723", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
