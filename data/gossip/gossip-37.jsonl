{"id": "3743095dd5fd0cb0", "field": "text", "it": "Non riesco a gestire questo {name} senza aiuto! Aiuto!", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g19-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "3743095dd5fd0cb0", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
