{"id": "0806952737e9ac18", "field": "text", "it": "Grazie, <signore/signorina>, per aver trovato la mia collana! Sei <il/la> migliore!", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g01-sg2@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "0806952737e9ac18", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
