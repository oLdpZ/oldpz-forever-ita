{"id": "087752b4db9289c0", "field": "text", "it": "Ehi, Nagmara! Che ne dici di un boccale di Birra dei ⟦Dark Iron=Ferroscuro⟧?", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g13-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "087752b4db9289c0", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
