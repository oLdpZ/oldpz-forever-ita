{"id": "d6908fe7313805b5", "field": "text", "it": "Forse la via del paladino non è la tua, ma potresti ancora trovare conforto nella Luce, se lo cerchi.", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g36-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "d6908fe7313805b5", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
