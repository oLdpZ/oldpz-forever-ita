{"id": "cbebe5a9504cf573", "field": "text", "it": "Salute, {class}! Ho un solo obiettivo: catalogare e registrare tutto il sapere legato alla storia di ⟦Duskwood=Boscovespro⟧ e ⟦Darkshire=Borgoscuro⟧. Forse potresti aiutarmi nella mia impresa?", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g35-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "cbebe5a9504cf573", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
