{"id": "240042af8130e656", "field": "text", "it": "Porti la contaminazione del Flagello. Preparati a entrare nella ⟦Twisting Nether=Distorsione Fatua⟧.", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g16-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "240042af8130e656", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
