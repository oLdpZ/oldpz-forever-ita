{"id": "72a816c83e4ad8c4", "field": "text", "it": "Allora va' da ⟦Una=Uma⟧, dagli armaioli di ⟦Thunder Bluff=Picco del Tuono⟧. Li trovi sull'altura di mezzo.", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g25-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "72a816c83e4ad8c4", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
