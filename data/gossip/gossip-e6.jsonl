{"id": "e6a824dc15398cf3", "field": "text", "it": "Cerchi Shenthul della Shadowswift Brotherhood, eh? Nel Varcolargo, di fronte a Droffers and Son Salvage, cerca un tunnel che scende nella Cleft of Shadow.", "status": "trusted", "checks": ["tiebreak"], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-r106-sg12@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "e6a824dc15398cf3", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": [{"it": "Cerchi Shenthul della Shadowswift Brotherhood, eh? In The Drag, di fronte a Droffers and Son Salvage, cerca un tunnel che scende nella Cleft of Shadow.", "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g38-sg3@2026-10-22", "imported": "2026-10-22"}}]}
