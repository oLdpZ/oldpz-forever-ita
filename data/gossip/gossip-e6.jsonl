{"id": "e600d32c88bbea26", "field": "text", "it": "L'anziano Bloodhoof si trova al ⟦Bloodhoof Village=Villaggio di Zoccolo Sanguinario⟧, a Mulgore.", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g37-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "e600d32c88bbea26", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
