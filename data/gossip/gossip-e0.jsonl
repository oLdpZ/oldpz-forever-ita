{"id": "e056cb6899e6501a", "field": "text", "it": "Salute, {name}. Se mi porti pietre necrotiche prese agli invasori non morti, posso darti accesso alle scorte dell'⟦Argent Dawn=Alba d'Argento⟧.", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g12-sg2@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "e056cb6899e6501a", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
