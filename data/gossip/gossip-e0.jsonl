{"id": "e0238426ebf72fdb", "field": "text", "it": "Odio questa parte del mio lavoro. Oh, ⟦Duskwood=Boscovespro⟧, sii gentile con il povero Antonio.", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g37-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "e0238426ebf72fdb", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
