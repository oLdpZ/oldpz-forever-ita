{"id": "91f35c6b3f5ba370", "field": "text", "it": "Custodisco il ricettacolo della sua rinascita. Se intendi affrontare questo compito, dovrai fortificare il ricettacolo e infine spezzare il dominio di Ragnaros in persona!", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g28-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "91f35c6b3f5ba370", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
{"id": "91f7f3fd5ff4d547", "field": "text", "it": "Su, facciamo a pugni, come gente civile.", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g29-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "91f7f3fd5ff4d547", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
