{"id": "691fd87b4d9d820d", "field": "text", "it": "Se hai tempo, Grimclaw e il suo padrone Volcor avrebbero bisogno del tuo aiuto. Se ti interessa, parla ancora con me...", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g24-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "691fd87b4d9d820d", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
