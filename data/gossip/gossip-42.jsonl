{"id": "426d4804095306c7", "field": "text", "it": "Althea, ci sono voci di strani avvenimenti al cimitero. Ello crede che sia il presagio di un attacco a ⟦Darkshire=Borgoscuro⟧.", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g20-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "426d4804095306c7", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
