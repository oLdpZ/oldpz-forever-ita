{"id": "34480b3ff3fce9bb", "field": "text", "it": "Il Dun Baldar North Bunker protegge l'ingresso orientale di Dun Baldar.\n\nNon è controllato da nessuna delle due parti.", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g18-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "34480b3ff3fce9bb", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
