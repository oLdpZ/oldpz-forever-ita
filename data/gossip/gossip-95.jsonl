{"id": "955b79c824df3898", "field": "text", "it": "Non mettiamoci nemmeno a confrontare le cicatrici di guerra, amico mio.", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g29-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "955b79c824df3898", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
