{"id": "8f25666b27c77a48", "field": "text", "it": "Venite, venite tutti! Le merci di Antonio sono in vendita. Potrei non tornare per molto tempo, quindi venite, venite tutti!", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g28-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "8f25666b27c77a48", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
