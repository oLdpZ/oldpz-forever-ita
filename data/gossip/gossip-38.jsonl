{"id": "3897cdaa9b643769", "field": "text", "it": "Dopo la seconda curva ecco {name}!", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g19-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "3897cdaa9b643769", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
