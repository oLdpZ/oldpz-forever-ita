{"id": "44036df1ca84a2fc", "field": "text", "it": "Sembra che tu abbia la stoffa di <un/una> grande fabbro. Ma prima di insegnarti qualcosa devo sapere se hai quel che serve.", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g20-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "44036df1ca84a2fc", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
