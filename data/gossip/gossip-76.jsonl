{"id": "7691190654cab07f", "field": "text", "it": "Ehi! Sei qui per una commissione di Tirth? Fossi in te, starei il più lontano possibile da lui! Ha il cervello marinato dall'alcol, ma la sua magia è potente come sempre!", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g26-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "7691190654cab07f", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
{"id": "7697733aca7176b0", "field": "text", "it": "Il Cimitero dei Lupi Bianchi appartiene all'⟦Alliance=Alleanza⟧.", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g26-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "7697733aca7176b0", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
{"id": "7699bbf7fec1fbde", "field": "text", "it": "È fatta! Il Signore del Ghiaccio è arrivato! Inchinatevi alla potenza dell'⟦Horde=Orda⟧, stolti!", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g26-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "7699bbf7fec1fbde", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
