{"id": "d70f9095da601e8e", "field": "text", "it": "Non so molto di magia, ma c'è un mago di nome Zaldimar che alloggia al Lion's Pride Inn e che probabilmente potrebbe aiutarti.", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g36-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "d70f9095da601e8e", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
