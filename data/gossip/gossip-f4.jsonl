{"id": "f47ff9121524700d", "field": "text", "it": "Grazie per aver tolto di mezzo quei senatori sciocchi. Ora preparati ad affrontare la tua fine per mano del più potente servitore di Ragnaros.", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g39-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "f47ff9121524700d", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
