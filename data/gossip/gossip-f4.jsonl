{"id": "f40a40e19d8e51f6", "field": "text", "it": "Questo {name} è senza dubbio un servitore dell'incubo di Naralex!", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g39-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "f40a40e19d8e51f6", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
