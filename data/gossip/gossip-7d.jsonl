{"id": "7d141c14e2b715c7", "field": "text", "it": "Se ci sei tu, io e Dadanga ci siamo. Andiamo!", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g26-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "7d141c14e2b715c7", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
