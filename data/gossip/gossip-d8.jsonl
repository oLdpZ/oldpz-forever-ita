{"id": "d8c37672748c3d95", "field": "text", "it": "È giunto il momento di scuotere il mondo fin dalle fondamenta! È ORA il momento di ricordare a chi vorrebbe renderci schiavi che non ci piegheremo mai!", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g36-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "d8c37672748c3d95", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
