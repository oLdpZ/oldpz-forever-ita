{"id": "75453b80afe7c8f1", "field": "text", "it": "Questo mi sembra familiare. Se continuiamo verso est, penso che potremo... Ahh! Viverna all'attacco!", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g25-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "75453b80afe7c8f1", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
