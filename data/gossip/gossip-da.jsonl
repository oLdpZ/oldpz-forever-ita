{"id": "da662b8c3ed4837f", "field": "text", "it": "Benvenut<o/a> all'⟦Camp Mojache=Accampamento Mojache⟧, <valoroso/valorosa> {class}. Come posso aiutarti quest'oggi?", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g12-sg2@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "da662b8c3ed4837f", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
{"id": "da6a198e03c2b582", "field": "text", "it": "La mia missione è compiuta. Potrei avere qualche rifornimento in più, se ti serve.", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g36-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "da6a198e03c2b582", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
