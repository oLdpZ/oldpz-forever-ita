{"id": "da50f9a0e1c909cb", "field": "text", "it": "Verserò il tuo sangue, {class}!", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g36-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "da50f9a0e1c909cb", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
