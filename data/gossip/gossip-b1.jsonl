{"id": "b1076bb568a06079", "field": "text", "it": "Sono Al'tabim l'Onniveggente, emissario di re Rastakhan.\n\nTratto con sacerdoti, maghi e stregoni.", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g11-sg2@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "b1076bb568a06079", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
