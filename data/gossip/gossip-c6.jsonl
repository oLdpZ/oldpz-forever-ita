{"id": "c6602f7e6a636198", "field": "text", "it": "La prima fase è finita. Big Will... fatti avanti!", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g34-sg3@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "c6602f7e6a636198", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
