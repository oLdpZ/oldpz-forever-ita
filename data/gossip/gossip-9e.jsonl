{"id": "9e02fba869ef2899", "field": "text", "it": "Vuoi imparare a usare un'arma, eh? Be', non startene lì a bocca aperta, parla, <ragazzo/ragazza>!", "status": "trusted", "checks": [], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g10-sg2@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "9e02fba869ef2899", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": []}
