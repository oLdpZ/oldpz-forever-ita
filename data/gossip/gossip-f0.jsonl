{"id": "f0b92989bbac2be7", "field": "text", "it": "Come mio fratello, onoro chi onora i propri antenati. È per me una grande gioia condividere i miei segreti artigianali con i discepoli della Celebrazione della Luna!", "status": "trusted", "checks": ["tiebreak"], "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-r1-sg4@2026-10-22", "imported": "2026-10-22"}, "english": {"hash": "f0b92989bbac2be7", "src": "gossip-key@normalize_v1"}, "reasons": [], "conflicts": [{"it": "Come mio fratello, onoro chi onora i propri antenati. È per me una grande gioia condividere i miei segreti artigianali con i discepoli del Festival della Luna!", "provenance": {"class": "machine", "model": "claude-opus-5-5", "source": "draft-g12-sg2@2026-10-22", "imported": "2026-10-22"}}]}
